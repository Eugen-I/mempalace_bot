{
  "$schema": "https://opencode.ai/config.json",

  // Модель по умолчанию
  "model": "qwen-dashscope/qwen3.8-max",

  "provider": {
    "qwen-dashscope": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "QwenCloud / DashScope",

      "options": {
        "baseURL": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
        "apiKey": "{env:DASHSCOPE_API_KEY}"
      },

      "models": {
        "qwen3.8-max": {
          "name": "Qwen3.8-Max",

          "limit": {
            "context": 1000000,
            "output": 131072
          }
        },

        "qwen3.7-max": {
          "name": "Qwen3.7-Max",

          "limit": {
            "context": 1000000,
            "output": 65536
          }
        }
      }
    }
  }
}
