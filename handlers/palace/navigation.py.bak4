@router.callback_query(F.data == "p_crai")
@allowed_callback
async def cb_cross_ai_article(cb: types.CallbackQuery):
    await cb.answer()
    uid = cb.from_user.id
    session = _room_session.get(uid)
    if not session:
        await safe_edit_text(cb.message, "❌ Нет данных для статьи.")
        return
    await safe_edit_text(cb.message, "🤖 Составляю статью из записей...")
    rooms = session.get("rooms", [])
    all_texts = []
    sources = []
    mcp = get_mcp()
    for wing, room in rooms:
        try:
            raw = await mcp.call_tool(
                "mempalace_list_drawers",
                {"room": room, "wing": wing} if wing else {"room": room},
            )
            parsed = json.loads(raw)
            drawers = parsed.get("drawers", parsed)
        except Exception:
            drawers = []
        for d in drawers:
            drawer_name = d.get("closet_name", d.get("title", d.get("name", "")))
            if drawer_name:
                try:
                    text = await mcp.call_tool(
                        "mempalace_get_drawer",
                        {"drawer": drawer_name, "room": room, "wing": wing}
                        if wing else {"drawer": drawer_name, "room": room},
                    )
                    if text:
                        all_texts.append(f"[{wing}/{room}] {text[:2000]}")
                        sources.append(f"{wing}/{room}")
                except Exception:
                    pass
    combined = "\n\n".join(all_texts) if all_texts else "Нет записей для анализа."
    from services.ai_engine import get_current_ai

            await safe_edit_text(
                cb.message,
                safe_html_format(resp_text)[:4000],
                parse_mode="HTML",
                reply_markup=kb.as_markup(),
            )
    try:
        resp = await asyncio.to_thread(
            _sync_ai_call_wrapper, engine, model, combined,
        )
        resp_text = resp or "❌ Пустой ответ от ИИ."
        _read_state[uid] = {"room": "", "wing": "", "drawer": "", "source": combined}
        kb = InlineKeyboardBuilder()
        kb.row(types.InlineKeyboardButton(
            text="💾 Сохранить статью", callback_data="p_cras",
        ))
        if len(resp_text) > 3500:
            kb.row(types.InlineKeyboardButton(
                text="📄 Далее", callback_data=f"p_cr:{0}",
            ))
        await safe_edit_text(cb.message, safe_html_format(resp_text)[:4000], parse_mode="HTML", reply_markup=kb.as_markup())
    except Exception as e:
        await safe_edit_text(cb.message, f"❌ Ошибка: {e}")


def _sync_ai_call_wrapper(engine: str, model: str, text: str) -> str:
    from services.ai_engine import _sync_ai_call

    msgs = [
        {"role": "system", "content": (
            "
".join(lines),
            "Структурируй: введение, основные темы, выводы."
        )},
        {"role": "user", "content": text},
    ]
    return _sync_ai_call(engine, model, msgs)


@router.callback_query(F.data == "p_cras")
@allowed_callback
async def cb_save_article(cb: types.CallbackQuery):
    await cb.answer()
    uid = cb.from_user.id
    state = _read_state.get(uid)
    if not state or not state.get("source"):
        await safe_edit_text(cb.message, "❌ Нет статьи для сохранения.")
        return
    article_text = cb.message.text or cb.message.html_text or ""
    notes_dir = os.path.join(DATA_DIR, "my_notes", "ai_articles")
    os.makedirs(notes_dir, exist_ok=True)
    fname = f"article_{int(time.time())}.md"
    with open(os.path.join(notes_dir, fname), "w", encoding="utf-8") as f:
        f.write(article_text)
    await safe_edit_text(cb.message, f"✅ Статья сохранена в my_notes/ai_articles/{fname}")


@router.callback_query(F.data.startswith("p_ct:"))
@allowed_callback
async def cb_record_connections(cb: types.CallbackQuery):
    await cb.answer()
    if not cb.data:
        return
    uid = cb.from_user.id
    _ = uid
    room = cb.data[5:]
    await safe_edit_text(cb.message, f"🔍 Ищу связанные комнаты для «{room}»...")
    mcp = get_mcp()
    try:
        connected = json.loads(
            await mcp.call_tool("mempalace_traverse", {"start_room": room, "max_hops": 1}),
        )
    except Exception:
            await safe_edit_text(
                cb.message,
                "\n".join(lines),
                reply_markup=kb.as_markup(),
            )
    if not connected:
        await safe_edit_text(cb.message, f"🔗 Для «{room}» нет связанных комнат.")
        return
    lines = [f"<b>🔗 Связанные комнаты для «{room}»:</b>\n"]
    for node in connected if isinstance(connected, list) else [connected]:
        if isinstance(node, dict):
            r = node.get("room", "?")
            w = node.get("wing", "?")
            lines.append(f"  • {safe_html_format(w)}/{safe_html_format(r)}")
    kb = InlineKeyboardBuilder()
    for node in connected if isinstance(connected, list) else [connected]:
        if isinstance(node, dict):
            r = node.get("room", "")
            w = node.get("wing", "")
            if r:
                kb.row(types.InlineKeyboardButton(
                    text=f"📄 {w}/{r}", callback_data=f"p_ctr:{r}",
                ))
    kb.row(types.InlineKeyboardButton(text="◀️ Назад", callback_data="p_bd"))
    await safe_edit_text(cb.message, "\n".join(lines), parse_mode="HTML", reply_markup=kb.as_markup())


@router.callback_query(F.data.startswith("p_ctr:"))
@allowed_callback
async def cb_connection_room(cb: types.CallbackQuery):
    await cb.answer()
    if not cb.data:
        return
    room = cb.data[6:]
    uid = cb.from_user.id
    state = _drawer_state.get(uid)
    wing = state.get("wing", "") if state else ""
    await _show_drawers_page(cb.message, uid, wing, room, 0)


# ─── TAXONOMY / GRAPH / TRAVERSE ───


@router.callback_query(F.data == "p_tax")
@allowed_callback
async def cb_taxonomy(cb: types.CallbackQuery):
    await cb.answer()
    msg = await safe_answer_returning_message(cb.message, "🏛️ Загружаю таксономию...")
    try:
        mcp = get_mcp()
        raw = await mcp.call_tool("mempalace_list_wings")
        parsed = json.loads(raw)
        wings = parsed.get("wings", parsed)
        if isinstance(wings, dict):
            lines = []
            for wing, count in sorted(wings.items(), key=lambda x: -x[1]):
                lines.append(f"<b>🪽 {safe_html_format(wing)}</b> ({count} записей)")
                try:
                    r_raw = await mcp.call_tool("mempalace_list_rooms", {"wing": wing})
                    r_parsed = json.loads(r_raw)
                    rooms = r_parsed.get("rooms", {})
                    for room, rcount in sorted(rooms.items(), key=lambda x: -x[1]):
                        lines.append(f"    📁 {safe_html_format(room)} — {rcount}")
                except Exception:
                    pass
            await safe_edit_text(msg, "\n".join(lines), parse_mode="HTML")
        else:
            await safe_edit_text(msg, "\n".join(f"  • {w}" for w in wings))
    except Exception as e:
        await safe_edit_text(msg, f"❌ Ошибка: {e}")


@router.callback_query(F.data == "p_grf")
@allowed_callback
async def cb_graph_stats(cb: types.CallbackQuery):
    await cb.answer()
    msg = await safe_answer_returning_message(cb.message, "📊 Строю граф связей...")
    if msg is None:
        return
    try:
        mcp = get_mcp()
        raw = await mcp.call_tool("mempalace_graph_stats")
        parsed = json.loads(raw)
        if isinstance(parsed, dict):
            lines = ["<b>📊 Граф связей</b>\n"]
            for k, v in parsed.items():
                if isinstance(v, dict):
                    lines.append(f"  <b>{k}:</b>")
                    for sk, sv in v.items():
                        lines.append(f"    • {sk}: {sv}")
                elif isinstance(v, list):
                    lines.append(f"  <b>{k}:</b> {', '.join(str(x) for x in v)}")
                else:
                    lines.append(f"  <b>{k}:</b> {v}")
            await safe_edit_text(msg, "\n".join(lines), parse_mode="HTML")
        else:
            await safe_edit_text(msg, str(parsed))
    except Exception as e:
        await safe_edit_text(msg, f"❌ Ошибка: {e}")


@router.callback_query(F.data == "p_trv")
@allowed_callback
async def cb_traverse_menu(cb: types.CallbackQuery):
    await cb.answer()
    _pending_mcp_input[cb.from_user.id] = "traverse"
    await safe_edit_text(cb.message,
                         "🔀 Введите комнату и (опционально) глубину обхода.\n"
                         "Пример: <code>мои_сны 3</code> (глубина 3)\n"
                         "Или просто: <code>архетипы</code> (глубина 2 по умолчанию)",
                         parse_mode="HTML",
                         )


@router.callback_query(F.data.startswith("p_tr_"))
@allowed_callback
async def cb_traverse_select(cb: types.CallbackQuery):
    await cb.answer()
    if not cb.data:
        return
    uid = cb.from_user.id
    room = cb.data[5:]
    _pending_mcp_input[uid] = "traverse"
    await safe_edit_text(
        cb.message,
        f"🔀 Комната выбрана: <code>{room}</code>. Теперь укажите глубину "
        f"(целое число, или Enter для 2):",
        parse_mode="HTML",
    )
