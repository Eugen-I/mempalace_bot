# Порядок загрузки: .env в корне проекта, затем legacy ~/Documents/mempalace/.env.
# Уже заданные переменные окружения не перезаписываются.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ADMIN_ID=0
ALLOWED_USERS=0
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
TAVILY_API_KEY=your_tavily_api_key
# MEMPALACE_DATA_DIR=/полный/путь/к/mempalace  # раскомментировать, если папка не в ~/Documents/mempalace
# AUTO_ATTACH_PHOTOS=false  # автоматически прикреплять фото к контексту ИИ (default: false)

# Garmin: export-first. Online-режим выключен по умолчанию.
# GARMIN_DATA_DIR=~/Documents/mempalace/garmin
# GARMIN_DB_PATH=~/Documents/mempalace/garmin/garmin.sqlite
# GARMIN_IMPORT_DIR=~/Documents/mempalace/garmin/import
# GARMIN_ONLINE_ENABLED=false
# GARMIN_AI_ENABLED=true
# GARMIN_AI_MODEL=qwen3.6-12b-uncensored:latest
# GARMIN_AI_TIMEOUT=120
# GARMIN_PLAN_HORIZON_WEEKS=6
# GARMIN_DATA_RETENTION_DAYS=365
# GARMIN_ENCRYPTION_KEY=  # только для тестов/CI; в проде ключ в macOS Keychain
# Только для локальных тестов/CI: разрешить fallback test-token вне pytest.
# MEMPALACE_ALLOW_TEST_TOKEN=0
