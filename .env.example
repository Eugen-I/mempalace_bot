# Порядок загрузки: .env в корне проекта, затем legacy ~/Documents/mempalace/.env.
# Уже заданные переменные окружения не перезаписываются.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ADMIN_ID=0
ALLOWED_USERS=0
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
TAVILY_API_KEY=your_tavily_api_key
# MEMPALACE_DATA_DIR=/полный/путь/к/mempalace  # раскомментировать, если папка не в ~/Documents/mempalace
# AUTO_ATTACH_PHOTOS=false  # автоматически прикреплять фото к контексту ИИ (default: false)
# Только для локальных тестов/CI: разрешить fallback test-token вне pytest.
# MEMPALACE_ALLOW_TEST_TOKEN=0
